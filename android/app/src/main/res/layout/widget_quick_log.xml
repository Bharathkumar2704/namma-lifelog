<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:text="@string/widget_title"
        android:textColor="#2A1A10"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:id="@+id/widget_type"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:text="⌨️"
        android:textSize="22sp"
        android:background="@drawable/widget_btn_light"
        android:contentDescription="@string/widget_type" />

    <TextView
        android:id="@+id/widget_voice"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="🎙️"
        android:textSize="26sp"
        android:background="@drawable/widget_btn_mic"
        android:contentDescription="@string/widget_voice" />
</LinearLayout>
